.PHONY : tests/test_AdjacencyMatrix.i

# target to preprocess a source file
tests/test_AdjacencyMatrix.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\tests.dir\build.make CMakeFiles/tests.dir/tests/test_AdjacencyMatrix.cpp.i
.PHONY : tests/test_AdjacencyMatrix.cpp.i

tests/test_AdjacencyMatrix.s: tests/test_AdjacencyMatrix.cpp.s
.PHONY : tests/test_AdjacencyMatrix.s

# target to generate assembly for a file
tests/test_AdjacencyMatrix.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\tests.dir\build.make CMakeFiles/tests.dir/tests/test_AdjacencyMatrix.cpp.s
.PHONY : tests/test_AdjacencyMatrix.cpp.s

